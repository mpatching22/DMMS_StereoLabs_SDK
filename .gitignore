# Recordings. Large binaries, and any captured imagery is client IP under the
# signed NDA / IP assignment. Never commit these.
*.svo
*.svo2
*.avi
*.mp4

# Generated output. Matched at any depth so renaming a folder does not silently
# re-expose these. Keep the folders themselves, ignore the contents.
**/out/*
**/data/*
!**/out/.gitkeep
!**/data/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
venv/
